# Kimi API 配置 (OpenAI 兼容接口)
KIMI_API_KEY=your_kimi_api_key_here
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

# 插桩开关：true 时在日志中打印每个 pipeline 节点耗时
ENABLE_TIMING=false

# 百度翻译 API（日语→中文）https://api.fanyi.baidu.com/
BAIDU_TRANSLATE_APP_ID=your_app_id_here
BAIDU_TRANSLATE_API_KEY=your_api_key_here
REPORT_MODEL=kimi-k2.5
